# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase ---
# Project Settings > Database > Connection string > "Transaction" pooler (port 6543).
# Used at runtime by the app (serverless-friendly pooled connection).
DATABASE_URL=

# Project Settings > Database > Connection string > "Session"/direct connection (port 5432).
# Used only for running Drizzle migrations.
DIRECT_URL=

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role (server-only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth ---
# The email allow-listed to access /admin (must match the email on the GitHub account used to sign in)
ADMIN_EMAIL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://naufalazim.com
